{
  "patterns": {
    "subjectId": {
      "regex": "\\b[A-Z0-9]{3,}-\\d{3,}\\b",
      "description": "Subject ID pattern (e.g., SITE-001)"
    },
    "clinicalDate": {
      "regex": "\\b\\d{2}-[A-Z]{3}-\\d{4}\\b",
      "description": "Clinical date format (DD-MMM-YYYY)"
    },
    "sasDataset": {
      "regex": "\\.sas7bdat$",
      "description": "SAS dataset file"
    },
    "xptDataset": {
      "regex": "\\.xpt$",
      "description": "XPT transport file"
    }
  },
  "version": "1.0.0"
}
