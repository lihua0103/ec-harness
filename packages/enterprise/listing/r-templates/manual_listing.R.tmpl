## ---- ALS 字段序（= 临床 DM 查看顺序）：列集合与列序都按数据库定义 ----
## eCRF 编号即表单字段顺序（记录级字段后跟内嵌表字段；VS 按测量项分组）。
## 输出面规则：lead 上下文键（中心/筛选号/状态/访视）最前，RECORDID 次之，
## ALS 序字段按编号排（SUBTRID/CSN 插到首个内嵌字段前），派生/匹配/flag 列原序尾接；
## SAS 源列不在 ALS 且非键的（勾选框组件子列 VSCSC_1/TNAME/AEACN_1 等）不进交付面。
ALS_ORD <- local({
  if (is.null(ALS_ECRF)) return(NULL)
  e0 <- ALS_ECRF
  ord <- list(); emb1 <- character(0)
  for (ds in unique(tb)) {
    idx <- which(tb == ds)
    idx <- idx[order(suppressWarnings(as.numeric(as.character(e0$编号[idx]))))]
    vars <- toupper(as.character(e0$变量[idx]))
    ord[[ds]] <- vars
    j <- which(tb0[idx] != ds)
    emb1[ds] <- if (length(j)) vars[j[1]] else NA_character_
  }
  nm2 <- !duplicated(as.character(e0$表名))
  n2o <- setNames(toupper(as.character(e0$表))[nm2], as.character(e0$表名)[nm2])
  ## 内嵌设计的 表名|表 补充索引：父表无自有字段时 eCRF 没有该表名行（如 其他检查/LBO，
  ## 全部字段挂在内嵌表 LBO_1 下）——不补则 als_arrange 按 TNAME 查不到而静默跳过该表，
  ## 系统列与勾选框组件子列（LBCSC_1-3 裸 0/1）漏进交付面（2026-09-10 LBO_01 收口）
  if (exists("ne") && !is.null(ne) && all(c("表名", "表") %in% names(ne))) {
    ntn <- trimws(as.character(ne$表名))
    nb <- !is.na(ntn) & ntn != "" & !ntn %in% trimws(names(n2o)) & !duplicated(ntn)
    n2o <- c(n2o, setNames(toupper(trimws(as.character(ne$表)))[nb], ntn[nb]))
    if (any(nb)) cat("ALS name2oid 补充（内嵌设计）:", paste(ntn[nb], collapse = ","), "\n")
  }
  list(ord = ord, emb1 = emb1, name2oid = n2o)
})
ALS_KEYS <- c("SITEID", "SUBJID", "STATUS", "VISIT", "RECORDID", "SUBTRID", "CSN")
als_arrange <- function(df) tryCatch({
  if (is.null(ALS_ORD)) return(df)
  ## [2026-09-10 DM 口径] 表单名称列（TNAME）保留并紧跟访视列后：多表单合并 sheet
  ## （重复核查类）靠它区分行属哪个表单，单表单 sheet 也保持一致口径，便于查找。
  ## 无访视列的表（如 SUBJECT 参与者信息）不加——ALS 键原位不被打扰。
  want_tn <- "VISIT" %in% names(df) && "TNAME" %in% names(df)
  if (want_tn) attr(df[["TNAME"]], "label") <- "表单名称"
  tn <- unique(chr_(df[["TNAME"]]))
  oid <- ALS_ORD$name2oid[tn[!is.na(tn) & tn != ""]]
  oid <- unique(unname(oid[!is.na(oid)]))
  if (!length(oid)) return(df)
  alsvars <- unique(unlist(lapply(oid, function(o) ALS_ORD$ord[[o]])))
  sascols <- unique(unlist(lapply(oid, function(o) if (o %in% names(rawdata)) names(rawdata[[o]]) else character(0))))
  keep <- names(df)[!(names(df) %in% sascols) |
                      names(df) %in% c(alsvars, ALS_KEYS, if (want_tn) "TNAME")]
  keep <- setdiff(keep, ".inv")
  df <- df[, keep, drop = FALSE]
  ## ALS 已定义的键（如 SUBJECT 的 SITEID/SUBJID/STATUS）按 ALS 原位走，不前置——
  ## 避免"中心编号"被提到最前而与 ALS 里相邻的"中心名称"拆开；
  ## 仅 ALS 未定义的导出键（普通表单的 SITEID/SUBJID/STATUS/VISIT）才前置
  lead <- intersect(setdiff(c("SITEID", "SUBJID", "STATUS", "VISIT"), alsvars), names(df))
  als_here <- alsvars[alsvars %in% names(df)]
  subid <- intersect(c("SUBTRID", "CSN"), names(df))
  e1 <- intersect(unname(ALS_ORD$emb1[oid]), names(df))
  tnv <- if (want_tn) "TNAME" else character(0)
  if (length(e1)) {
    i <- match(e1[1], als_here)
    ord <- c(lead, tnv, "RECORDID", als_here[seq_len(i - 1)], subid, als_here[i:length(als_here)])
  } else {
    ord <- c(lead, tnv, "RECORDID", als_here, subid)
  }
  ord <- unique(intersect(ord, names(df)))
  rest <- setdiff(names(df), ord)
  df[, c(ord, rest), drop = FALSE]
}, error = function(err) { cat("als_arrange skip:", conditionMessage(err), "\n"); df })

