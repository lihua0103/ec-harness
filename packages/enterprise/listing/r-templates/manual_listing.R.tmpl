## RT01 manual 固定审核列：FLAG(New/Modified/Old)（首版=New）、Update Detail、
## Review Comments、Initial/Date 供 DM 填写。
## 注意：Flag1 只在该行 DVP 本身有 flag 逻辑时存在，不为凑格式注入空列。
append_audit_cols <- function(df) {
  df <- as.data.frame(df)
  for (cc in names(df)) {                              # 日期/时间转文本，避免 openxlsx 数字化
    if (inherits(df[[cc]], "Date")) {                  # 纯日期按原始 SAS 数据集显示形态（不带时间后缀）
      lab <- attr(df[[cc]], "label")                   # format() 会丢 attr label，先保后还原
      df[[cc]] <- format(df[[cc]], "%Y-%m-%d")
      attr(df[[cc]], "label") <- lab
    } else if (inherits(df[[cc]], "POSIXt")) {
      lab <- attr(df[[cc]], "label")
      df[[cc]] <- format(df[[cc]], "%Y-%m-%d %H:%M:%S")
      attr(df[[cc]], "label") <- lab
    }
  }
  for (cc in names(df)) {                              # SAS 时间(hms/difftime) -> HH:MM:SS 文本，NA 落空
    if (inherits(df[[cc]], "difftime")) {
      v <- suppressWarnings(as.numeric(df[[cc]]))
      df[[cc]] <- ifelse(is.na(v), NA_character_,
                         sprintf("%02d:%02d:%02d", as.integer(v %/% 3600),
                                 as.integer((v %% 3600) %/% 60), as.integer(round(v %% 60))))
    }
  }
  ## 注：不清洗字面 "NA"——源数据中存在录入为 "NA" 的真实值（如单位），
  ## 时间列的 NA 显示问题已由上方 hms -> HH:MM:SS 转换解决
  df[["FLAG(New/Modified/Old)"]] <- rep("New", nrow(df))   # 首次交付，无旧版比对
  df[["Update Detail"]] <- rep("", nrow(df))
  df[["Review Comments"]] <- rep("", nrow(df))
  df[["Initial/Date"]] <- rep("", nrow(df))
  df
}
