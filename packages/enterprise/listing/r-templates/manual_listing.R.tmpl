## 编码解码：FORMATS(FMTNAME/START/LABEL) -> dec(格式名, 值)
FMT <- rawdata$FORMATS %>%
  transmute(FMTNAME, KEY = as.character(START), LABEL = as.character(LABEL)) %>%
  filter(!is.na(KEY), KEY != "") %>% distinct(FMTNAME, KEY, .keep_all = TRUE)
dec <- function(fmt, x) {
  m <- FMT %>% filter(FMTNAME == fmt)
  if (!nrow(m)) return(as.character(x))
  idx <- match(as.character(x), m$KEY)
  out <- as.character(x); hit <- !is.na(idx)
  out[hit] <- m$LABEL[idx[hit]]; out
}
YN  <- function(x) dec("IEYN", x)          # 1=是 2=否 3=不适用（各 PERF/YN 共用编码）
yn  <- YN                                  # 小写别名（历史习惯）
CLS <- function(x) dec("VSCLSIG1A", x)     # 1=正常 2=异常无临床意义 3=异常有临床意义 4=未查

## ---- 全局值解码（2026-09-09 按参考程序 KXZY-GB08 decode_by_sasfmt 经验补齐）----
## 按每列自身 format.sas 绑定把编码值替换为中文标签：Raw data 原样指的是记录/列
## 结构不动，编码值必须解码成中文才是 DM 可读的"原样"（此前只解码了显式 dec()
## 涉及的列，Raw data 直出列残留 1/2 裸码，如 是否药物滥用史/是否筛选成功）。
## 安全性已实测：勾选手项列（AEACN_1/2/3/99）、VISITOID、INV/TID/RECORDID/SID/
## SUBJID 等逻辑键列均无 format.sas 绑定不受影响；下游逻辑取值全部经 dec()/YN()
## （未命中原样返回、幂等），日期列 YYMMDD 不在 FORMATS 值域目录内自动跳过。
decode_by_sasfmt <- function(d) {
  for (cc in setdiff(names(d), "VISITNAME")) {   # VISITNAME 的解码由 vlab/vis_scope 负责，预解码会破坏 vlab 回退判断
    f <- attr(d[[cc]], "format.sas")
    if (is.null(f) || !nzchar(f) || f == "$") next
    m <- FMT[FMT$FMTNAME == sub("^\\$", "", f), ]
    if (!nrow(m)) next
    v   <- as.character(d[[cc]])
    idx <- match(v, m$KEY)
    hit <- !is.na(idx)
    if (any(hit)) {
      lab <- attr(d[[cc]], "label")
      v[hit] <- m$LABEL[idx[hit]]
      d[[cc]] <- v
      attr(d[[cc]], "label") <- lab        # 赋值丢 attr，还原 ALS 表头
    }
  }
  d
}
rawdata <- lapply(rawdata, decode_by_sasfmt)

## ---- 小工具（公共） ----
blank <- function(x) is.na(x) | trimws(as.character(x)) == ""
any_kw <- function(x, kws) {                     # 多关键词命中（fixed，locale 安全）
  hit <- rep(FALSE, length(x))
  for (k in kws) hit <- hit | grepl(k, x, fixed = TRUE)
  hit
}
num_  <- function(x) suppressWarnings(as.numeric(as.character(x)))
chr_  <- function(x) as.character(x)
dt_   <- function(x) {
  if (inherits(x, "Date")) return(x)
  s <- trimws(as.character(x)); s[grepl("^(UK|UNK|NA|)$", s, ignore.case = TRUE)] <- NA
  d <- suppressWarnings(as.Date(s, format = "%Y-%m-%d"))
  p7 <- !is.na(s) & is.na(d) & nchar(s) == 7                       # "2026-07" -> "2026-07-01"
  if (any(p7)) {
    d[p7] <- suppressWarnings(as.Date(paste0(s[p7], "-01"), format = "%Y-%m-%d"))
  }
  d
}
dts <- function(x) { d <- dt_(x); ifelse(is.na(d), "", format(d, "%Y-%m-%d")) }
## 匹配列日期：完整日期规范化输出；部分未知（如 2025-02-UK）原样保留；空值输出空。
## dts 会把 UK 部分日期吞成空，匹配列丢失"开始日期部分未知"信息，
## 与 Raw data 列/Condition 按 UK 字符串判定的项目口径不一致（2026-09-11 DM 复审修复）
dts_raw <- function(x) {
  s <- trimws(as.character(x)); s[is.na(s)] <- ""
  out <- rep("", length(s))
  ok <- grepl("^\\d{4}-\\d{2}-\\d{2}$", s)
  out[ok] <- s[ok]
  part <- !ok & nzchar(s) & !grepl("^(UK|UNK|NA)$", s, ignore.case = TRUE)
  out[part] <- s[part]
  out
}
vlab <- function(oid, vname) {
  d <- dec("VISITNAME", vname)
  d <- ifelse(blank(d) | d == chr_(vname), paste0("访视", chr_(oid)), d)
  ifelse(blank(chr_(oid)), d, paste0(d, "(", chr_(oid), ")"))
}
norm_t <- function(x) gsub("[[:space:][:punct:]]+", "", toupper(as.character(x)))
SPLIT_SEP <- "\r"                                # 内部占位分隔符（ASCII，locale 安全）
sep_norm <- function(s) {                        # 各类分隔符统一为 SPLIT_SEP（fixed，免正则）
  for (sep in c("；", "、", "，", ";", ",")) s <- gsub(sep, SPLIT_SEP, s, fixed = TRUE)
  s
}
split_ids <- function(s) {
  if (length(s) == 0) return(character(0))
  out <- trimws(unlist(strsplit(sep_norm(as.character(s)), SPLIT_SEP, fixed = TRUE)))
  out[!is.na(out) & out != ""]
}
first_id <- function(s) {                       # "2,呕吐,2026-07-02；1,恶心,..." -> "2"
  v <- sapply(seq_along(s), function(i) {
    t <- split_ids(s[i]); if (!length(t)) return(NA_character_)
    ifelse(grepl("^[0-9]+", t[1]), sub("^([0-9]+).*", "\\1", t[1]), t[1]) })
  as.character(v)
}
ae_ids <- function(s) {                         # 按"；"分段，每段取开头编号 -> c("2","1")
  out <- character(0)
  for (v in s) {
    if (blank(v)) next
    semi <- gsub(";", SPLIT_SEP, gsub("；", SPLIT_SEP, as.character(v), fixed = TRUE), fixed = TRUE)
    seg <- trimws(unlist(strsplit(semi, SPLIT_SEP, fixed = TRUE)))
    seg <- seg[!is.na(seg) & seg != ""]
    for (g in seg) {
      t <- split_ids(g)
      if (!length(t)) next
      out <- c(out, ifelse(grepl("^[0-9]+", t[1]), sub("^([0-9]+).*", "\\1", t[1]), t[1]))
    }
  }
  out
}
dig5 <- function(x) { d <- gsub("\\D", "", as.character(x))
  ifelse(nchar(d) >= 5, substr(d, nchar(d) - 4, nchar(d)), d) }
rng_out <- function(x, lo, hi) { v <- num_(x); !is.na(v) & (v < lo | v > hi) }
grp_flag <- function(df, key, flg = "flag") {  # 组内 >1 行 => Y（key 在数据掩码内求值）
  key <- rlang::enquo(key)
  df %>% mutate(.k = !!key) %>% group_by(.k) %>%
    mutate(!!flg := if_else(dplyr::n() > 1, "Y", "")) %>%
    ungroup() %>% select(-.k)
}
## 按 spec"相同的记录"判重：同键下来自不同 RECORDID（表记录）才计重复，
## 避免同一条记录的多 logline 互相自重
grp_flag_rec <- function(df, key, flg = "flag") {
  key <- rlang::enquo(key)
  df %>% mutate(.k = !!key) %>% group_by(.k) %>%
    mutate(!!flg := if_else(dplyr::n_distinct(RECORDID) > 1, "Y", "")) %>%
    ungroup() %>% select(-.k)
}
## SAS 时间（秒/hms）-> "HH:MM:SS" 文本，NA -> ""
fmt_hms <- function(x) {
  v <- suppressWarnings(as.numeric(x))
  ifelse(is.na(v), "", sprintf("%02d:%02d:%02d",
                               as.integer(v %/% 3600),
                               as.integer((v %% 3600) %/% 60),
                               as.integer(round(v %% 60))))
}
min_dt <- function(x) { x <- x[!is.na(x)]; if (length(x)) min(x) else as.Date(NA) }
