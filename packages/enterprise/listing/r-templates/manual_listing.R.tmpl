## Content Form Name 显示中文表单名（对齐 EDC 模板；来源=DVP Form Name 列）：
## 核查节提供 LISTING_TITLES（按 sheet 名键控）则用之，否则回退 sheet 名。
## [2026-09-10 DM 口径] 同名表单多个 listing 时 DM 无法区分——重名标题追加
## （sheet 名）后缀保持唯一（与 spec Unique ID 回写的 listing 代码互为溯源）
cttl <- vapply(names(outlisting), function(nm) {
  n2 <- sub("^Manual_", "", nm)
  if (exists("LISTING_TITLES") && n2 %in% names(LISTING_TITLES)) LISTING_TITLES[[n2]] else n2
}, character(1))
dup_t <- names(table(cttl))[table(cttl) > 1]
cttl[cttl %in% dup_t] <- paste0(cttl[cttl %in% dup_t], "（", sub("^Manual_", "", names(cttl))[cttl %in% dup_t], "）")
i <- 0
for (nm in names(outlisting)) {
  i <- i + 1
  d   <- as.data.frame(outlisting[[nm]])
  nm2 <- sub("^Manual_", "", nm)          # Sheet 名/显示名不带 Manual_ 前缀
  ttl <- cttl[[nm]]
  write_listing_sheet(wb, nm2, d, ttl = ttl)   # B1 页名与 Content 同款（含同名去重后缀）
  r <- 2 + i
  writeData(wb, "Content", sprintf("%02d", i), startCol = 1, startRow = r, colNames = FALSE)
  writeFormula(wb, "Content",
               sprintf('HYPERLINK("#\'%s\'!A1","%s")', nm2, ttl), startCol = 2, startRow = r)
  writeData(wb, "Content", "New", startCol = 3, startRow = r, colNames = FALSE)
  writeData(wb, "Content", nrow(d), startCol = 4, startRow = r, colNames = FALSE)
  writeData(wb, "Content", nrow(d), startCol = 5, startRow = r, colNames = FALSE)
  writeData(wb, "Content", 0, startCol = 6, startRow = r, colNames = FALSE)
  writeData(wb, "Content", 0, startCol = 7, startRow = r, colNames = FALSE)
  addStyle(wb, "Content", STY$data, rows = r, cols = c(1, 3:7), stack = FALSE)
  addStyle(wb, "Content", STY$link_bd, rows = r, cols = 2, stack = FALSE)
}
freezePane(wb, "Content", firstActiveRow = 3)
## openxlsx 写入时自动 +0.7109375 边距，传裸宽度使 XML 值等于规范定值
