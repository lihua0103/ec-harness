## ---- 医学编码结果（PT 术语）装载与查询 ----
## 编码结果 xlsx 与 sas 数据集同目录放置（服务器同步位置），文件名含"编码/coding"。
## MedDRA sheet：第 1-2 行为版本横幅、第 3 行表头；列 Subject/RecordPosition/
## DataPageName/TERM/pt_name（WHODrug sheet 为用药编码，如需可仿此扩展）。
## [REPLACE] CODING_FILE：编码结果文件完整路径；留空则在 sas 同目录按文件名自动发现。
CODING_FILE <- ""                                   # [REPLACE] 编码结果文件路径（空=sas 同目录自动发现）
load_pt_map <- function() {
  f <- CODING_FILE
  ## 发现顺序：显式路径 -> sas 数据集同目录 -> 数据日期文件夹（递归，覆盖 zip 含子目录的摆法）
  if (!nzchar(f) && nzchar(SAS_DIR)) {
    cands <- list.files(SAS_DIR, pattern = "\\.(xlsx|csv)$", ignore.case = TRUE, full.names = TRUE)
    cands <- cands[grepl("编码|coding", basename(cands), ignore.case = TRUE)]
    if (length(cands)) f <- cands[1]
  }
  if (!nzchar(f)) {
    cands <- list.files(folder_path, pattern = "\\.(xlsx|csv)$", ignore.case = TRUE,
                        full.names = TRUE, recursive = TRUE)
    cands <- cands[grepl("编码|coding", basename(cands), ignore.case = TRUE)]
    if (length(cands)) f <- cands[1]
  }
  if (!nzchar(f) || !file.exists(f)) {
    message("编码结果未提供（sas 同目录/数据日期文件夹未发现编码|coding 文件）：PT术语列取表单术语字段原值")
    return(NULL)
  }
  ## openxlsx 无 getSheets 导出（报错被 tryCatch 吞掉会恒回退 "MedDRA"——编码文件
  ## 目标页名不是 MedDRA 时读错页）；用 getSheetNames，并优先选名含 MedDRA 的页
  sh <- tryCatch({
    sns <- openxlsx::getSheetNames(f)
    sns[grepl("MedDRA", sns, ignore.case = TRUE)][1]
  }, error = function(e) NA_character_)
  if (is.na(sh)) sh <- "MedDRA"
  m0 <- as.data.frame(openxlsx::read.xlsx(f, sheet = sh, colNames = FALSE, skipEmptyRows = TRUE))
  hidx <- which(apply(m0, 1, function(r) any(!is.na(r) & as.character(r) == "Subject")))[1]
  if (is.na(hidx)) {
    warning("编码结果文件未找到表头行（Subject），已回退：", f)
    return(NULL)
  }
  body <- m0[(hidx + 1):nrow(m0), ]
  names(body) <- as.character(unlist(m0[hidx, ]))
  need <- c("Subject", "RecordPosition", "DataPageName", "TERM", "pt_name")
  if (!all(need %in% names(body))) {
    warning("编码结果 MedDRA sheet 缺少列：", paste(setdiff(need, names(body)), collapse = ","), "；已回退：", f)
    return(NULL)
  }
  ## 编码导出可能把中文存成数字字符引用（如 &#26082;），openxlsx 不解析；统一解码
  decode_ent1 <- function(s) {
    if (is.na(s) || !grepl("&#[0-9]+;", s)) return(s)
    m <- gregexpr("&#([0-9]+);", s, perl = TRUE)[[1]]
    out <- ""; last <- 1
    for (i in seq_along(m)) {
      st <- m[i]; en <- st + attr(m, "match.length")[i] - 1
      if (st > last) out <- paste0(out, substr(s, last, st - 1))
      out <- paste0(out, intToUtf8(as.integer(sub("^&#([0-9]+);$", "\\1", substr(s, st, en)))))
      last <- en + 1
    }
    if (last <= nchar(s)) out <- paste0(out, substr(s, last, nchar(s)))
    out
  }
  decode_ent <- function(x) {
    x <- as.character(x)
    if (!any(grepl("&#[0-9]+;", x))) return(x)
    vapply(x, decode_ent1, character(1), USE.NAMES = FALSE)
  }
  ## 解码必须在构建键之前（norm_t 会破坏实体串结构）
  body$SUB <- tolower(decode_ent(trimws(as.character(body$Subject))))
  body$PG  <- trimws(decode_ent(trimws(as.character(body$DataPageName))))
  body$POS <- gsub("\\.0$", "", trimws(as.character(body$RecordPosition)))
  body$PTV <- trimws(decode_ent(trimws(as.character(body$pt_name))))
  body$TK  <- norm_t(decode_ent(trimws(as.character(body$TERM))))
  body <- body[!blank(body$PTV), ]
  ## 记录级键：受试者|页名|RecordPosition；词典级键：规范化 TERM -> PT（MedDRA 同词同 PT）
  rec <- body[!blank(body$SUB) & !blank(body$POS), c("SUB", "PG", "POS", "PTV")]
  rec$KEY <- paste(rec$SUB, rec$PG, rec$POS, sep = "|")
  rec <- rec[!duplicated(rec$KEY), c("KEY", "PTV")]
  trm <- body[!blank(body$TK), c("TK", "PTV")]
  trm <- trm[!duplicated(trm$TK), ]
  if (nrow(rec) + nrow(trm) == 0) {
    warning("编码结果无有效 PT 映射，已回退：", f)
    return(NULL)
  }
  cat("编码结果装载：记录级", nrow(rec), "条 / 词典级", nrow(trm), "条（", basename(f), "）\n")
  list(REC_KEY = rec$KEY, REC_PT = rec$PTV, TRM_KEY = trm$TK, TRM_PT = trm$PTV)
}
