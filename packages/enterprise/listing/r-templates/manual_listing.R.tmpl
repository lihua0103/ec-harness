## 解压策略：
##   服务器 Linux：优先系统 unzip（模板同款，能正确建子目录、支持 -P 密码）；
##   系统 unzip 不可用 => R 内置 unzip 兜底，但必须先按 zip 条目预建子目录
##   （内置引擎不会自动建目录，否则报 "cannot open file './xxx/yyy'"）。

## ---- 归档密码自动推导（对齐 listing 插件 archive_passwords.py 的候选顺序）----
## 顺序：显式密码 -> 项目目录名及其分词组合 -> zip同目录*.txt sidecar 内容
##       -> zip 文件名及其分词组合 -> 项目目录 .txt/.xlsx/.xls 文件名 stem -> 无密码
split_tokens <- function(v) {
  t <- trimws(unlist(strsplit(v, "[_/.\\s-]+")))
  t[nzchar(t)]
}
token_pw <- function(v) {
  toks <- split_tokens(v)
  out <- unique(c(v, tools::file_path_sans_ext(v), toks[tolower(toks) != "" & nchar(toks) >= 2]))
  if (length(toks) >= 2) {
    combo <- character(0)
    for (s in seq_along(toks)) for (e in seq(s + 1, length(toks)))
      combo <- c(combo, paste(toks[s:e], collapse = c("", "_", "-")))
    out <- c(out, unique(combo[nchar(combo) >= 2]))
  }
  nums <- regmatches(v, gregexpr("[0-9]{2,}", v))[[1]]
  c(out, nums)
}
password_candidates <- function(project_dir, data_dir) {
  cand <- character(0)
  add <- function(v) if (!is.na(v) && nzchar(v) && !v %in% cand) cand <<- c(cand, v)
  add(password)                                   # 显式（可为空）
  for (v in token_pw(basename(project_dir))) add(v)
  for (f in list.files(data_dir, pattern = "\\.txt$", full.names = TRUE)) {
    for (v in strsplit(trimws(paste(readLines(f, warn = FALSE), collapse = " ")), "\\r?\\n")[[1]])
      add(trimws(v))
  }
  for (z in list.files(data_dir, pattern = "\\.zip$")) for (v in token_pw(z)) add(v)
  for (f in list.files(project_dir, pattern = "\\.(txt|xlsx|xls)$", recursive = TRUE, full.names = TRUE))
    add(tools::file_path_sans_ext(basename(f)))
  add("")                                         # 无密码兜底
  cand
}
zip_extract <- function(zipfile, exdir) {
  dir.create(exdir, showWarnings = FALSE, recursive = TRUE)
  st <- NULL
  for (pw in password_candidates(dirname(exdir), exdir)) {
    if (.Platform$OS.type == "unix") {
      pwa <- if (nzchar(pw)) sprintf("-P %s", shQuote(pw)) else ""
      st <- system(sprintf("unzip -o %s %s -d %s", shQuote(zipfile), pwa, shQuote(exdir)))
      if (st == 0 && length(list.files(exdir, pattern = "\\.sas7bdat$", recursive = TRUE)) > 0)
        return(invisible())
      next
    } else if (nzchar(pw)) {
      next   # Windows 无系统 unzip：加密包请在服务器跑
    }
    break   # 无密码候选交给下方 R 内置 unzip 兜底
  }
  if (is.null(st)) warning("本平台无系统 unzip 可用，改用 R 内置 unzip 兜底：", zipfile)
  else warning("系统 unzip 未成功（返回", st, "），改用 R 内置 unzip 兜底：", zipfile)
  lst <- tryCatch(unzip(zipfile, list = TRUE), error = function(e) NULL)
  if (!is.null(lst) && !is.null(lst$Name)) {
    for (dd in unique(dirname(lst$Name))) {
      dd2 <- file.path(exdir, dd)
      if (dd2 != exdir) dir.create(dd2, showWarnings = FALSE, recursive = TRUE)
    }
  }
  unzip(zipfile, exdir = exdir)
}
read_sas_folder <- function(folder_path, foldername, clear_sasdata = TRUE) {
  ## 数据日期文件夹（zip 所在目录）即工作目录：解压与 RData 缓存都放这里
  data_path <- file.path(folder_path, foldername)
  if (!dir_ok(data_path))
    stop("数据日期文件夹不存在：", data_path, "\n请检查配置段 folder_path / foldername [REPLACE R1]")
  save_filename <- file.path(data_path, paste0("sas_data_", foldername, ".RData"))
  all_files <- list.files(data_path, pattern = "\\.sas7bdat$", recursive = TRUE, full.names = TRUE)
  ## RData 缓存命中即直接用（勿再解压 zip：Windows 无系统 unzip 且缓存已含全部数据集）
  if (!length(all_files) && !file.exists(save_filename)) {
    zips <- list.files(data_path, pattern = "\\.zip$", full.names = TRUE)
    if (!length(zips))
      zips <- list.files(folder_path, pattern = "SAS7BDAT.*\\.zip$",
                         full.names = TRUE, recursive = TRUE)
    for (z in zips) zip_extract(z, data_path)
    all_files <- list.files(data_path, pattern = "\\.sas7bdat$", recursive = TRUE, full.names = TRUE)
  }
  ## sas 数据集所在目录（无论是否缓存命中都要记录；编码结果同目录放置）
  if (length(all_files)) {
    SAS_DIR <<- dirname(all_files[1])
  } else if (file.exists(save_filename)) {
    SAS_DIR <<- data_path        # 缓存命中且 sas7bdat 已清理（服务器 zip_clear）
  } else {
    stop("未找到sas7bdat（也未见可解压的zip）：", data_path, "\n请检查 [REPLACE R1]")
  }
  if (!file.exists(save_filename)) {
    ## 挂载 EDC 二进制格式目录（比 FORMATS 数据集完整）：编码值自动带上 value labels
    catf <- list.files(data_path, pattern = "\\.sas7bcat$", recursive = TRUE, full.names = TRUE)
    datasets  <- lapply(all_files, function(x) {
      if (length(catf)) haven::read_sas(x, catalog_file = catf) else haven::read_sas(x)
    })
    names(datasets) <- toupper(file_path_sans_ext(basename(all_files)))
    save(datasets, file = save_filename)
    if (clear_sasdata)
      unlink(list.files(data_path, pattern = "\\.sas7bdat$", recursive = TRUE, full.names = TRUE))
  }
  save_filename
}
