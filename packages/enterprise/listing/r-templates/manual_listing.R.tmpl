  for (d in dirs) f <- c(f, list.files(d, pattern = "\\.xlsx?$", full.names = TRUE))
  f <- f[grepl("数据库定义|ALS", basename(f), ignore.case = TRUE)]
  f <- f[!grepl("^~\\$", basename(f))]                 # Excel 打开时的 ~$ 锁文件排除
  if (length(f)) f[1] else ""
})
