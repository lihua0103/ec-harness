## CS 判定（"检查结果为CS" = 临床意义判定 = 异常有临床意义；编码已确证 1正常 2异常无 3异常有）
cs_flag <- function(x) dec("VSCLSIG1A", x) == "异常有临床意义"
## 生命体征一行多个检查项（VSCLSIG1..4），任一项 CS 即视为 CS 行
vs_any_cs <- function(d) {
  m <- sapply(paste0("VSCLSIG", 1:4), function(cc) {
    if (is.null(d[[cc]])) logical(nrow(d)) else cs_flag(d[[cc]])
  })
  if (is.null(dim(m))) m else as.vector(rowSums(m) > 0)
}

## CS/编号 匹配展开（DVP Condition：当检查结果为CS时匹配；多选拆分，一行仅显示一条）
## cs：逻辑向量，TRUE 的行才抓取病史/AE 信息；非 CS 行匹配列留空、不拆分
expand_ref <- function(df, cs = rep(TRUE, nrow(df))) {
  rows <- list(); k <- 0
  for (i in seq_len(nrow(df))) {
    r <- as.data.frame(df[i, ])
    do_m <- isTRUE(cs[i])
    mi <- if (do_m) ae_ids(r$MHNO) else character(0)
    ai <- if (do_m) ae_ids(r$AENO) else character(0)
    ids <- c(if (length(mi)) paste0("M|", mi), if (length(ai)) paste0("A|", ai))
    if (!length(ids)) {
      k <- k + 1
      rows[[k]] <- cbind(r, `匹配病史/AE编号` = "", `匹配病史/AE名称` = "",
                         `匹配病史/AE开始日期` = "", `匹配病史/AE结束日期` = "")
      next
    }
    for (kk in ids) {
      tt <- substr(kk, 1, 1); idd <- substr(kk, 3, nchar(kk))
      if (tt == "M") {
        j <- match(paste(r$SID, idd), paste(MH_A$SID, MH_A$CSNc))
        v <- data.frame(`匹配病史/AE编号` = idd,
                        `匹配病史/AE名称` = ifelse(is.na(j), "", chr_(MH_A$MHTERM[j])),
                        `匹配病史/AE开始日期` = ifelse(is.na(j), "", dts_raw(MH_A$MHSTDAT[j])),
                        `匹配病史/AE结束日期` = ifelse(is.na(j), "", dts_raw(MH_A$MHENDAT[j])),
                        check.names = FALSE)
      } else {
        j <- match(paste(r$SID, idd), paste(AE_A$SID, AE_A$CSNc))
        v <- data.frame(`匹配病史/AE编号` = idd,
                        `匹配病史/AE名称` = ifelse(is.na(j), "", chr_(AE_A$AETERM[j])),
                        `匹配病史/AE开始日期` = ifelse(is.na(j), "", dts_raw(AE_A$AESTDAT[j])),
                        `匹配病史/AE结束日期` = ifelse(is.na(j), "", dts_raw(AE_A$AEENDAT[j])),
                        check.names = FALSE)
      }
      k <- k + 1; rows[[k]] <- cbind(r, v)
    }
  }
  dplyr::bind_rows(rows)
}
