  header  = createStyle(fontName = "Times New Roman", fontSize = 13,
                        textDecoration = "bold", fgFill = "#EDF2F9",
                        halign = "center", valign = "center", wrapText = TRUE,
                        border = "TopBottomLeftRight", borderStyle = "thin"),
  data    = createStyle(fontName = "Times New Roman", fontSize = 13,
                        valign = "center",
                        border = "TopBottomLeftRight", borderStyle = "thin"),
  link    = createStyle(fontName = "Times New Roman", fontSize = 13,
                        fontColour = "#0563C1", textDecoration = "underline"),
  link_bd = createStyle(fontName = "Times New Roman", fontSize = 13,
                        fontColour = "#0563C1", textDecoration = "underline",
                        border = "TopBottomLeftRight", borderStyle = "thin")
)
write_listing_sheet <- function(wb, nm, df0, ttl = NULL) {
  ## nm：Sheet 名/显示名（已去掉 Manual_ 前缀）；返回链接文本按惯例为 "go back"
  df  <- append_audit_cols(df0)
  ## 剔除内部辅助列与 EDC 系统/审计列（对齐 KXZY drop_sys_varible_baiaozhi 清单），
  ## 只在写盘层裁——RDS/比对仍保留全列；唯一值序号/键列（TNAME/RECORDID/SUBTRID/CSN）
  ## 按需求保留，访视显示用 lead_cols 的解码 VISIT 列（原始 OID 码列一并裁掉）
  drop_internal <- c(".inv", "PERF", "CSNc", "AESTd", "AEENDd", "MHSTd", "MHENDd",
                     "CMSTd", "CMENDd", "PRSTd", "PRENd", "LBDATEd", "DSSTDATd",
                     "DTHDATd", "DSLSTDATd", "ICDATd", "ICREDATd", "ECDATd", "VISDATd",
                     "DSENDATd",
                     "STUDYCODE", "SID", "TID", "SVNUM", "VISITOID", "VISITNAME",
                     "CRFSTS", "CRFVER", "CUSERN", "CROLE", "CTIME", "MUSERN", "MROLE", "MTIME")
  ## INVNAM（研究者）不在清单：SUBJECT 的 ALS 定义它是表单字段（普通表单由
  ## als_arrange 按 ALS 裁掉；源数据本就全空）
  df <- df[, !names(df) %in% drop_internal, drop = FALSE]
  n   <- nrow(df); p <- ncol(df)
  addWorksheet(wb, nm)
  ## 网格线保持 Excel 默认显示（如需对齐 RT01 规范隐藏，改回 showGridLines = FALSE）
  ## 第1行：A1 返回 Content 链接；B1:F1 合并显示中文表单名（2026-09-10 DM 口径，
  ## 对齐 EDC 模板；ttl 参数 = Content 循环传入的显示标题（含同名（代码）去重后缀，
  ## B1 与 Content 一致）；缺项回退 LISTING_TITLES/sheet 名）
  writeFormula(wb, nm, 'HYPERLINK("#Content!A1","go back")', startCol = 1, startRow = 1)
  addStyle(wb, nm, STY$link, rows = 1, cols = 1, stack = FALSE)
  endm <- min(6, max(p, 2))
  ttl1 <- if (!is.null(ttl) && nzchar(ttl)) ttl else
    if (exists("LISTING_TITLES") && nm %in% names(LISTING_TITLES)) LISTING_TITLES[[nm]] else nm
  writeData(wb, nm, data.frame(x = ttl1), startRow = 1, startCol = 2, colNames = FALSE)
  if (endm > 2) mergeCells(wb, nm, cols = 2:endm, rows = 1)
  addStyle(wb, nm, STY$title_s, rows = 1, cols = 2:endm, stack = FALSE)
  ## 第2行：Label 表头（attr 标签优先；attr 丢失时按变量名从源数据恢复；缺失回退变量名）
  labs <- vapply(names(df), function(cc) {
    l <- lab_of(df, cc)
    if (identical(l, cc) && cc %in% names(SRC_LABELS)) l <- SRC_LABELS[[cc]]
    l
  }, character(1))
  ## 重名列消歧：同名 label 从第二个起追加"（变量名）"，便于 DM 与程序化解析区分
  dupl <- duplicated(labs)
  if (any(dupl)) labs[dupl] <- paste0(labs[dupl], "（", names(df)[dupl], "）")
  writeData(wb, nm, t(labs), startRow = 2, colNames = FALSE)
  addStyle(wb, nm, STY$header, rows = 2, cols = 1:p, stack = FALSE)
  setRowHeights(wb, nm, rows = 2, heights = 60)
  ## 第3行起：数据；空表写一行带边框的占位行，保持表格线可见
  if (n > 0) {
    writeData(wb, nm, df, startRow = 3, colNames = FALSE)
    addStyle(wb, nm, STY$data, rows = 3:(n + 2), cols = 1:p, stack = FALSE, gridExpand = TRUE)
    addFilter(wb, nm, rows = 2, cols = 1:p)
  } else {
    ph <- matrix(c("无数据记录", rep("", max(p - 1, 0))), nrow = 1)
    writeData(wb, nm, ph, startRow = 3, colNames = FALSE)
    addStyle(wb, nm, STY$data, rows = 3, cols = 1:p, stack = FALSE, gridExpand = TRUE)
  }
  freezePane(wb, nm, firstActiveRow = 3)
  ## 列宽自适应（表头/数据最大字符宽，上限60下限10）
  wdt <- vapply(names(df), function(cc) {
    v <- as.character(df[[cc]]); v <- v[!is.na(v)]
    m <- max(c(nchar(lab_of(df, cc)), if (length(v)) max(nchar(v)) else 0), na.rm = TRUE)
    min(60, max(10, 1.3 * m))
  }, numeric(1))
  setColWidths(wb, nm, cols = 1:p, widths = wdt)
}
wb <- createWorkbook()
## openxlsx 4.x 的 genBaseSheetRels 会在建 sheet 时写悬空的 drawing/vml 关系
##（无对应文件；Excel 可打开，openpyxl/pandas 等严格解析器报错）。
