## PT 查询：记录级（受试者|页名|RecordPosition）命中 -> PT；
##          词典级（规范化 TERM）命中 -> PT；未命中 -> 空
##（PT术语只来自编码结果，不回退原值，避免混淆已编码/未编码）
pt_of <- function(sid, page, pos, term) {
  raw <- trimws(as.character(term)); raw[raw == "NA"] <- ""
  out <- rep("", length(raw))
  if (is.null(PT_MAP)) {
    message("编码结果未提供：PT术语列为空（编码文件放入 sas 数据集同目录后自动匹配）")
    attr(out, "hit") <- rep(FALSE, length(raw))
    return(out)
  }
  hit <- rep(FALSE, length(raw))
  pg <- trimws(as.character(page))
  k1 <- paste(tolower(trimws(as.character(sid))), pg,
              gsub("\\.0$", "", trimws(as.character(pos))), sep = "|")
  h1 <- !blank(pg) & k1 %in% PT_MAP$REC_KEY
  out[h1] <- PT_MAP$REC_PT[match(k1[h1], PT_MAP$REC_KEY)]; hit <- hit | h1
  k2 <- norm_t(raw)
  h2 <- !hit & !blank(k2) & k2 %in% PT_MAP$TRM_KEY
  out[h2] <- PT_MAP$TRM_PT[match(k2[h2], PT_MAP$TRM_KEY)]; hit <- hit | h2
  if (any(!hit & !blank(raw)))
    cat("编码结果未命中 ", sum(!hit & !blank(raw)), " 条术语，PT术语置空\n")
  attr(out, "hit") <- hit
  out
}

## ---- 用药编码结果（WHODrug Product_Name）装载与查询 ----
## [2026-09-11 DM 新增需求] 既往或合并用药 listing 药物名称后加一列匹配编码结果 Product_Name。
## 与 MedDRA 同一编码文件的 WHODrug sheet；表头按"含 Subject 单元格"定位；
## 页名键=既往及伴随用药（已对 DataPageName 实际去重值域核对：既往及伴随用药/润肤剂使用情况，
## 本 listing 只匹配前者）；记录级（受试者|页名|RecordPosition）优先，词典级（规范化 Drug）回退，
## 未命中置空并计数。
load_drug_map <- function() {
  f <- CODING_FILE
  if (!nzchar(f) && nzchar(SAS_DIR)) {
    cands <- list.files(SAS_DIR, pattern = "\\.(xlsx|csv)$", ignore.case = TRUE, full.names = TRUE)
    cands <- cands[grepl("编码|coding", basename(cands), ignore.case = TRUE)]
    if (length(cands)) f <- cands[1]
  }
  if (!nzchar(f)) {
    cands <- list.files(folder_path, pattern = "\\.(xlsx|csv)$", ignore.case = TRUE,
                        full.names = TRUE, recursive = TRUE)
    cands <- cands[grepl("编码|coding", basename(cands), ignore.case = TRUE)]
    if (length(cands)) f <- cands[1]
  }
  if (!nzchar(f) || !file.exists(f)) {
    message("用药编码结果未提供（未发现 编码|coding 文件）：Product_Name 列取空")
    return(NULL)
  }
  sheets <- tryCatch(openxlsx::getSheetNames(f), error = function(e) character(0))
  sh <- sheets[grepl("WHODrug", sheets, ignore.case = TRUE)]
  if (!length(sh)) { message("编码文件无 WHODrug sheet：Product_Name 列取空（", basename(f), "）"); return(NULL) }
  m0 <- as.data.frame(openxlsx::read.xlsx(f, sheet = sh[1], colNames = FALSE, skipEmptyRows = TRUE))
  hidx <- which(apply(m0, 1, function(r) any(!is.na(r) & as.character(r) == "Subject")))[1]
  if (is.na(hidx)) { warning("WHODrug sheet 未找到表头行（Subject），已回退：", f); return(NULL) }
  body <- m0[(hidx + 1):nrow(m0), ]
  names(body) <- as.character(unlist(m0[hidx, ]))
  need <- c("Subject", "RecordPosition", "DataPageName", "Drug", "Product_Name")
  if (!all(need %in% names(body))) {
    warning("编码结果 WHODrug sheet 缺少列：", paste(setdiff(need, names(body)), collapse = ","), "；已回退：", f)
    return(NULL)
  }
  ## 中文数字字符引用解码（同 MedDRA 装载；构建键之前）
  decode_ent1 <- function(s) {
    if (is.na(s) || !grepl("&#[0-9]+;", s)) return(s)
    m <- gregexpr("&#([0-9]+);", s, perl = TRUE)[[1]]
    out <- ""; last <- 1
    for (i in seq_along(m)) {
      st <- m[i]; en <- st + attr(m, "match.length")[i] - 1
      if (st > last) out <- paste0(out, substr(s, last, st - 1))
      out <- paste0(out, intToUtf8(as.integer(sub("^&#([0-9]+);$", "\\1", substr(s, st, en)))))
      last <- en + 1
    }
    if (last <= nchar(s)) out <- paste0(out, substr(s, last, nchar(s)))
    out
  }
  decode_ent <- function(x) {
    x <- as.character(x)
    if (!any(grepl("&#[0-9]+;", x))) return(x)
    vapply(x, decode_ent1, character(1), USE.NAMES = FALSE)
  }
  body$SUB <- tolower(decode_ent(trimws(as.character(body$Subject))))
  body$POS <- gsub("\\.0$", "", trimws(as.character(body$RecordPosition)))
  body$PG  <- trimws(decode_ent(trimws(as.character(body$DataPageName))))
  body$PN  <- trimws(decode_ent(trimws(as.character(body$Product_Name))))
  body$TK  <- norm_t(decode_ent(trimws(as.character(body$Drug))))
  body <- body[!blank(body$PN), ]
  rec <- body[!blank(body$SUB) & !blank(body$POS), c("SUB", "PG", "POS", "PN")]
  rec$KEY <- paste(rec$SUB, rec$PG, rec$POS, sep = "|")
  rec <- rec[!duplicated(rec$KEY), c("KEY", "PN")]
  trm <- body[!blank(body$TK), c("TK", "PN")]
  trm <- trm[!duplicated(trm$TK), ]
  if (nrow(rec) + nrow(trm) == 0) { warning("WHODrug 编码无有效 Product_Name 映射，已回退：", f); return(NULL) }
  cat("用药编码装载：记录级", nrow(rec), "条 / 词典级", nrow(trm), "条（", basename(f), "）\n")
  list(REC_KEY = rec$KEY, REC_PN = rec$PN, TRM_KEY = trm$TK, TRM_PN = trm$PN)
}
