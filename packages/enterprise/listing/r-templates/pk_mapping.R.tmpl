save_file <- file.path(sas_path, paste0("sas_data_", foldername, ".RData"))
if (!file.exists(save_file)) {
  setwd(sas_path)
  if (nzchar(password)) system(sprintf("unzip -P %s *.zip -d ./", password))
  fs <- list.files(sas_path, pattern = "\\.sas7bdat$", full.names = TRUE, recursive = TRUE)
  if (!length(fs)) stop("未找到 sas7bdat（也未见可解压产物）：", sas_path)
  datasets <- lapply(fs, function(x) haven::read_sas(x))
  names(datasets) <- toupper(file_path_sans_ext(basename(fs)))
  save(datasets, file = save_file)
  unlink(fs)
}
load(save_file)
rawdata <- datasets; rm(datasets)

pk_fs <- list.files(csv_path, pattern = "\\.(csv|xlsx|xls)$", full.names = TRUE, ignore.case = TRUE)
if (!length(pk_fs)) stop("PK 数据目录无 csv/xlsx：", csv_path)
if (length(pk_fs) > 1) note("PK 数据目录多个文件，取第一个：", basename(pk_fs[1]))
PK_data <- read_excel(pk_fs[1])
{
  canon <- c("studyid", "analyte", "subject", "period", "samplingtime(h)",      # 表头归一：
             "concentration(ng/ml)", "lloq(ng/ml)", "uloq(ng/ml)", "comments") # 空格形态不可控
  want  <- c("Study ID", "Analyte", "Subject", "Period", "Sampling Time(h)",
             "Concentration (ng/mL)", "LLOQ(ng/mL)", "ULOQ(ng/mL)", "Comments")
  k <- match(tolower(gsub("[[:space:]]+", "", names(PK_data))), canon)
  names(PK_data)[!is.na(k)] <- want[k[!is.na(k)]]
  need <- c("Study ID", "Subject", "Period", "Sampling Time(h)", "Concentration (ng/mL)")
  if (!all(need %in% names(PK_data)))
    stop("PK 数据缺必需列：", paste(setdiff(need, names(PK_data)), collapse = ", "),
         "\n实际表头：", paste(names(PK_data), collapse = " | "),
         "\n若投递件为 SAD/MAD 形态（Matrix/Day Nominal/Hour Nominal 列），请以 form=\"sad-mad\" 重渲染（两型分模板，勿猜）")
  if (!"Comments" %in% names(PK_data)) PK_data$Comments <- NA_character_
}
PK_data <- PK_data %>%
  mutate(`Concentration (ng/mL)` = case_when(
    `Concentration (ng/mL)` == "BQL" ~ "BQL",
    T ~ as.character(round(as.numeric(`Concentration (ng/mL)`), 3))   # 最终输出统一 3 位精度
  ))

