# -------- 编盲双产物（binded）[REPLACE P9] --------------------------------------
if (nzchar(BLIND_MAP_FILE) && file.exists(BLIND_MAP_FILE)) {
  BIND <- read_excel(BLIND_MAP_FILE, col_types = c("text","text"))
  names(BIND)[1:2] <- c("SUBJID","BLINDID")
  if (anyDuplicated(BIND$SUBJID) || anyDuplicated(BIND$BLINDID))
    stop("编盲表 SUBJID/BLINDID 必须一对一——请数据方修正后重跑")
  if (!sum(PK_data_cohrt$SUBJID %in% BIND$SUBJID))
    stop("编盲表与 PK 受试者号零命中——核对号体系（随机号 or 筛选号）后重跑")
  PK_Mapping_binded <- PK_data_cohrt %>%
    left_join(BIND %>% select(SUBJID,BLINDID), by = "SUBJID") %>%
    select(-SEQ,-TRT,-HEIGHT,-BMI,-WEIGHT,-SEX,-AGE,-SUBJID) %>%
    rename("SUBJID" = "BLINDID") %>%
    select(STUDYID,SUBJID,everything()) %>%
    arrange(SUBJID,PERIOD,RT)
  if (nrow(PK_Mapping_binded) != nrow(PK_data_cohrt) || anyNA(PK_Mapping_binded$SUBJID))
    stop("自检红线：binded 炸行或存在 NA 盲号——编盲表覆盖不完整，停止写盘")
  attr(PK_Mapping_binded$SUBJID, "label") <- "Participant"
  openxlsx::write.xlsx(PK_Mapping_binded, file = paste0("PK_Mapping_binded_", foldername, ".xlsx"),
                       sheetName = "PK_Mapping", overwrite = TRUE)
  note("binded 产物：", nrow(PK_Mapping_binded), " 行 x ", ncol(PK_Mapping_binded),
       " 列（编盲表换号，剔 7 敏感列）")
  outputs_extra <- paste0("PK_Mapping_binded_", foldername, ".xlsx")
}

