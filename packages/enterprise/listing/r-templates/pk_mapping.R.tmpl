# -------- 运行摘要（宿主回执唯一来源；只含计数/文件名/告警） --------------------
run_warnings <- unique(run_warnings)
json_str <- function(x) {
  x <- gsub("\\", "\\\\", x, fixed = TRUE); x <- gsub("\"", "\\\"", x, fixed = TRUE)
  x <- gsub("\r", "", x, fixed = TRUE); x <- gsub("\n", "\\n", x, fixed = TRUE)
  paste0("\"", x, "\"")
}
json_arr <- function(items) paste0("[", paste(items, collapse = ","), "]")
out_files <- c(paste0("PK_Mapping_unbinded_", foldername, ".xlsx"), qc_rds_file, outputs_extra)
summary_json <- paste0(
  "{",
  '"status":"ok",',
  '"lane":"r_pk",',
  '"studyKey":', json_str(study_key), ",",
  '"dataDate":', json_str(foldername), ",",
  '"blindMode":', json_str(blind_mode), ",",
  '"listingCount":', 1L, ",",
  '"rowCount":', nrow(PK_data_cohrt), ",",
  '"flagCount":', as.integer(sum(qc)), ",",
  '"sheetCount":', 1L, ",",
  '"outputs":', json_arr(json_str(out_files)), ",",
  '"warnings":', json_arr(vapply(run_warnings, json_str, character(1))), ",",
  '"listings":', json_arr(sprintf(
    '{"name":"PK Mapping","sheet":"PK_Mapping","rowCount":%d,"flagCount":%d}',
    nrow(PK_data_cohrt), as.integer(sum(qc)))),
  "}")
writeLines(enc2utf8(summary_json), summary_path, useBytes = TRUE)
