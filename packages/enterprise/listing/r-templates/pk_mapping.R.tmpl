# SEQ/TRT：默认空串占位；配置 RAND_SCHED_FILE 时读真值（Subject+Period+Seq+Trt 长表）
SEQ_V <- rep("", nrow(PK_data)); TRT_V <- rep("", nrow(PK_data))
if (nzchar(RAND_SCHED_FILE) && file.exists(RAND_SCHED_FILE)) {
  rs <- if (grepl("\\.csv$", RAND_SCHED_FILE, ignore.case = TRUE))
    read.csv(RAND_SCHED_FILE, colClasses = "character", check.names = FALSE) else read_excel(RAND_SCHED_FILE)
  nh <- function(h) tolower(gsub("[[:space:]]+", "", h))
  cn <- function(...) { for (p in list(...)) { h <- which(nh(names(rs)) == p); if (length(h)) return(h[1]) }; NA_integer_ }
  cs <- cn("subject", "subjectid", "randid"); cp <- cn("period"); cq <- cn("seq", "sequence"); ct <- cn("trt", "treatment")
  if (is.na(cs) || is.na(cq)) stop("随机化 schedule 缺 Subject/Seq 列，实际表头：", paste(names(rs), collapse = " | "))
  SEQ_V <- unname(setNames(rs[[cq]], rs[[cs]])[as.character(PK_data$Subject)]); SEQ_V[is.na(SEQ_V)] <- ""
  if (!is.na(cp) && !is.na(ct)) {
    TRT_V <- unname(setNames(rs[[ct]], paste(rs[[cs]], as.character(rs[[cp]]), sep = "|"))[
      paste(as.character(PK_data$Subject), as.character(PK_data$Period), sep = "|")])
    TRT_V[is.na(TRT_V)] <- ""
  }
  note("SEQ/TRT 已按随机化 schedule 填真值：", basename(RAND_SCHED_FILE))
}

