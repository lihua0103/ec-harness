# round_half_up：×10^n 先 round 6 位去 double 噪声再 +0.5（十进制半进位，8.0125→8.013）
round_half_up <- function(x, digits = 0) {
  z <- round(abs(x) * 10^digits, 6); z <- floor(z + 0.5); z * sign(x) / 10^digits
}

