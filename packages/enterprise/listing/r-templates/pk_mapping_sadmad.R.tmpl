# 解密=数据准备步骤（R 交付零 python）：程序只读 _dec 副本；加密原件由 read_pk 守卫给出路
read_pk <- function(path) {
  d <- tryCatch(
    suppressMessages(as.data.frame(read_excel(path, col_types = "text"))),
    error = function(e) {
      if (grepl("encrypt|Unsupported format", e$message, ignore.case = TRUE))
        stop("输入为加密 .xls：请先完成数据准备步骤——用 pw.txt 解密生成 _dec 副本，",
             "并把传输件放回数据日目录（解密命令见数据交接说明）。")
      stop("读取失败：", e$message)
    })
  names(d) <- trimws(names(d))
  d
}
