/**
 * 企业白标品牌核心（ADR-0002）。
 *
 * 从 `feat/data-egress-switch-refactor` 分支 `emerald-clinical-data-guard`
 * 的 `src/branding.js` 迁入，并按官方 `dsh-v0.1.1-rc.2` 的扩展点重排：
 *
 * - 首选官方结构化注入行（`webserver/index-inject` 事件）：品牌全局变量、
 *   `application-name` meta、客户端品牌脚本都作为行注入，JSON 可序列化，
 *   服务端渲染与静态 worker 部署两条渲染路径都吃同一张表。
 * - `<title>` 交换无法表达为行（行只能插到 head/body 开标签之后），
 *   走官方明文标注的 `tapIndex` 逃生口。
 * - `/favicon.svg` 与 `/manifest.webmanifest` 用 `webServer.register`
 *   具名路由接管，`no-store` 防止品牌切换后残留旧缓存。
 * - 临床出域开关 UI 与 `/api/settings/data-interception` 是业务插件
 *   的一部分（依赖其 policy 对象），刻意不迁入本包。
 */
import { readFile } from 'node:fs/promises'
import type { IncomingMessage, ServerResponse } from 'node:http'
import type { Context } from '@deepseek-ai/cordis'

const FAVICON_URL = new URL('../assets/branding/favicon.svg', import.meta.url)
const BRAND_GLOBAL = '__DSH_ENTERPRISE_BRAND__'

/** 官方 index 注入行的结构镜像（@deepseek-ai/dsh-host-webserver 的公开契约）。 */
export type IndexInjectionRow =
  | { kind: 'global'; name: string; value: unknown }
  | { kind: 'script'; placement: 'head' | 'body'; text: string }
  | { kind: 'script-src'; placement: 'head' | 'body'; src: string }
  | { kind: 'style'; text: string }
  | { kind: 'html'; placement: 'head' | 'body'; html: string }

/** 本插件用到的 `ctx.webServer` 服务面（结构子集，见 ADR-0002 决策 3）。 */
interface WebServerLike {
  tapIndex(transform: (html: string) => string): () => void
  register(route: {
    kind: 'exact' | 'prefix'
    path: string
    handler: (req: IncomingMessage, res: ServerResponse) => void | Promise<void>
  }): () => void
}

/**
 * 事件类型补全：官方 webserver 包通过模块合并声明 `webserver/index-inject`。
 * 本包不依赖该包（企业包只 peer 依赖 cordis 内核），在此镜像同一签名，
 * 使 `ctx.on` 拿到完整类型。若未来把官方包纳为真实依赖，删除本合并即可。
 */
declare module '@deepseek-ai/cordis' {
  interface Events {
    'webserver/index-inject': (table: IndexInjectionRow[]) => void
  }
}

export interface BrandingConfig {
  /** 完整品牌名，出现在标题、manifest 与正文替换（1..80 字符，禁尖括号）。 */
  brandName?: string
  /** 短名，替换正文中的 DSH 缩写（1..24 字符，禁尖括号）。 */
  brandShortName?: string
}

export interface Brand {
  brandName: string
  brandShortName: string
}

function escapeHtml(value: string): string {
  return value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
}

/** 校验并归一品牌配置：patch row config > 环境变量 > 默认值。 */
export function validateBrandingConfig(raw: BrandingConfig = {}): Brand {
  const brandName = (raw.brandName ?? process.env.DSH_BRAND_NAME ?? 'DSH Enterprise').trim()
  const brandShortName = (raw.brandShortName ?? process.env.DSH_BRAND_SHORT_NAME ?? 'DSH').trim()
  if (brandName.length === 0 || brandName.length > 80 || /[<>]/.test(brandName)) {
    throw new Error('brandName must be 1..80 characters and cannot contain angle brackets')
  }
  if (brandShortName.length === 0 || brandShortName.length > 24 || /[<>]/.test(brandShortName)) {
    throw new Error('brandShortName must be 1..24 characters and cannot contain angle brackets')
  }
  return { brandName, brandShortName }
}

/**
 * 客户端品牌脚本。放在 body 开标签之后（而非 head）：head 行渲染在
 * `<head>` 开标签内侧，若把这段约 4KB 的内联脚本插在 charset meta 之前，
 * 非 ASCII 品牌名会先于编码声明进入前 1024 字节之外的解析窗口。
 *
 * 职责：锁定 document.title；TreeWalker 遍历文本节点做品牌词替换
 * （`DeepSeek (Harness)` → 品牌名，`\bDSH\b` → 短名）；对 aria-label /
 * title / alt / placeholder 等展示属性做同样替换（TreeWalker 只走文本
 * 节点，属性字样读屏器仍会读出——如模型选择器的
 * `aria-label="选择模型，当前 DeepSeek-…"`）；跳过带 `data-no-brand`
 * 的祖先容器；隐藏官方内联 SVG 标志并注入 favicon 图标与品牌名（只追加
 * 兄弟节点，不触碰 React 管理的节点）；防抖 MutationObserver 应对重挂载。
 * 替换回调一律用函数形式，避免品牌名中的 `$` 被 String.replace 当作
 * 替换模式解释。
 */
const CLIENT_SCRIPT = `
;(function() {
  var brand = globalThis[${JSON.stringify(BRAND_GLOBAL)}]
  if (!brand) return
  var BRAND_ATTRS = ['aria-label', 'title', 'alt', 'placeholder']
  function brandReplace(value) {
    return value
      .replace(/DeepSeek(?: Harness)?/gi, function() { return brand.brandName })
      .replace(/\bDSH\b/g, function() { return brand.brandShortName })
  }
  function inNoBrand(node) {
    for (var anc = node; anc; anc = anc.parentElement) {
      if (anc.dataset && 'noBrand' in anc.dataset) return true
    }
    return false
  }
  function apply() {
    if (document.title !== brand.brandName) document.title = brand.brandName
    if (!document.body) return
    var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT)
    while (walker.nextNode()) {
      var node = walker.currentNode
      if (inNoBrand(node.parentElement)) continue
      var replaced = brandReplace(node.nodeValue)
      if (replaced !== node.nodeValue) node.nodeValue = replaced
    }
    var elements = document.body.querySelectorAll('*')
    for (var i = 0; i < elements.length; i++) {
      var el = elements[i]
      if (inNoBrand(el)) continue
      for (var j = 0; j < BRAND_ATTRS.length; j++) {
        var name = BRAND_ATTRS[j]
        var value = el.getAttribute(name)
        if (!value) continue
        var attrReplaced = brandReplace(value)
        if (attrReplaced !== value) el.setAttribute(name, attrReplaced)
      }
    }
    if (!document.getElementById('brand-logo-css')) {
      var style = document.createElement('style')
      style.id = 'brand-logo-css'
      style.textContent = 'div[class*="logoRow"] button[class*="brand"] .jIPhXG_brandIdentity, svg[class*="railFish"] { display: none !important; }'
      document.head.append(style)
    }
    var brandBtn = document.querySelector('div[class*="logoRow"] > button[class*="brand"]')
    if (brandBtn && !brandBtn.querySelector('[data-brand-logo]')) {
      var wrap = document.createElement('span')
      wrap.setAttribute('data-brand-logo', '')
      wrap.style.cssText = 'display:inline-flex;align-items:center;gap:8px;color:inherit;'
      var img = document.createElement('img')
      img.src = '/favicon.svg'
      img.alt = ''
      img.width = 22
      img.height = 22
      var label = document.createElement('span')
      label.textContent = brand.brandName
      label.style.cssText = 'font-size:15px;font-weight:600;letter-spacing:.2px;white-space:nowrap;'
      wrap.append(img, label)
      brandBtn.append(wrap)
    }
    var fish = document.querySelector('svg[class*="railFish"]')
    var railImg = document.querySelector('img[data-brand-fish]')
    if (fish && !railImg) {
      var fishImg = document.createElement('img')
      fishImg.src = '/favicon.svg'
      fishImg.alt = brand.brandShortName
      fishImg.width = fish.width.baseVal.value || 24
      fishImg.height = fish.height.baseVal.value || 24
      var fishClass = fish.getAttribute('class') || ''
      fishImg.setAttribute('class', fishClass)
      fishImg.setAttribute('data-brand-fish', '')
      fishImg.style.cssText = 'display: block; pointer-events: none;'
      fish.parentNode.insertBefore(fishImg, fish)
      fish.style.display = 'none'
    } else if (!fish && railImg) {
      railImg.remove()
    }
    var allSvgs = document.querySelectorAll('svg')
    for (var k = 0; k < allSvgs.length; k++) {
      var svg = allSvgs[k]
      var ariaLabel = svg.getAttribute('aria-label')
      if (ariaLabel && /deepseek/i.test(ariaLabel)) {
        svg.setAttribute('aria-label', brandReplace(ariaLabel))
      }
    }
  }
  apply()
  var scheduled = false
  function schedule() {
    if (scheduled) return
    scheduled = true
    setTimeout(function() { scheduled = false; apply() }, 100)
  }
  new MutationObserver(schedule).observe(document.documentElement, { childList: true, subtree: true, characterData: true })
})();
`