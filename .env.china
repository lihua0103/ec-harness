# Emerald Clinical 配置文件
# 🔥 国内用户推荐配置

# ============================================
# LLM API Configuration (选择一个)
# ============================================

# 选项1: 智谱GLM (推荐，国内可直接访问)
EMERALD_UPSTREAM_BASE=https://open.bigmodel.cn
EMERALD_UPSTREAM_PATH=/api/paas/v4/chat/completions

# 选项2: DeepSeek API (国内可直接访问)
# EMERALD_UPSTREAM_BASE=https://api.deepseek.com
# EMERALD_UPSTREAM_PATH=/v1

# 选项3: OpenAI (需要代理)
# EMERALD_UPSTREAM_BASE=https://api.openai.com
# EMERALD_UPSTREAM_PATH=/v1
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ============================================
# Data Protection (数据保护)
# ============================================

# enforce = 严格模式（生产环境）
# shadow = 影子模式（测试，只记录不拦截）
# disabled = 禁用（不推荐）
DATA_PROTECTION_MODE=enforce

# ============================================
# Optional (可选)
# ============================================

# 自动打开浏览器
AUTO_OPEN_BROWSER=false

# API Key (如果需要)
# GLM_API_KEY=your-key-here
# DEEPSEEK_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
