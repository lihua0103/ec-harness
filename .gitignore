node_modules/
.pnpm-store/
.env
*.log
coverage/
dist/
lib/
.upstream-cache/

*.tsbuildinfo

# 官方每次 boot 都会重写 profile 的根配置（profile-boot.ts prepareProfile
# 无条件 writeFileSync），跟踪它会造成永久脏工作树。真正该编辑的是
# cordis.patch.yml。
profiles/*/cordis.yml

# 上游 agent 笔记：内容与 upstream/deepseek-harness/.agents 逐字重复，
# 企业层不应再存一份（见 ADR-0001）。
/.agents/

# pnpm 在不支持 unlink 的挂载盘上留下的空临时文件（如网络盘/虚拟机共享目录）。
/_tmp_*

# 官方运行时在 $DSH_HOME 下的持久化产物。因 DSH_HOME 就是仓库根
# （官方 resolveProfileDir 契约，见 ADR-0001），这些目录会生成在此。
# 内含会话数据，既是运行状态也可能含业务内容，务必不要提交。
/storages/
/.dsh/

# 本地归档凭证，禁止提交。
/.credentials.yaml
/profiles/.credentials.yaml
/profiles/settings.yaml

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 会话数据
/sessions/

# 临时测试文件
*.backup
*.new

# 数据安全运行时状态（ui-settings DataSecurityService / 审计）
/profiles/enterprise/.data-security.json
/profiles/enterprise/.data-audit.jsonl

# 冒烟/评测产物与临时目录（含真实试验编号，禁止提交）
/artifacts/
/tmp/
/.pytest_cache/
