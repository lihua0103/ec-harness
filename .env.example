# DSH Guard 环境变量配置

# ============ DeepSeek API ============
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============ 应用配置 ============
NODE_ENV=development
LOG_LEVEL=info
PORT=3080

# ============ 企业品牌 ============
# 也可在 configs/cordis.yml 的 branding 段配置（cordis.yml 优先）
# brandName: 1-80 字符，不含尖括号；brandShortName: 1-24 字符
EMERALD_BRAND_NAME=Emerald Clinical
EMERALD_BRAND_SHORT_NAME=Emerald

# ============ 数据拦截开关 ============
# 设为 0 关闭数据拦截（智能功能仍生效）。默认开启。
# DATA_INTERCEPTION_ENABLED=1
# 单次扫描最大行数，整数 1-200，默认 20
# MAX_SCAN_ROWS=20

# ============ Python 运行时 ============
# Python 解释器路径。留空则自动检测 python/.venv，其次系统 python3。
# PLUGIN_PYTHON=/path/to/python3
# 临时目录（worker 内部使用，默认 python/../.cache/tmp）
# EMERALD_TMP_ROOT=/path/to/tmp

# ============ 本地数据访问 ============
# disabled（默认）| uat-local。启用本地 UAT 数据工作流时设为 uat-local
# EMERALD_LOCAL_DATA_ACCESS=uat-local
# 兼容回退：仅当宿主无法提供 session cwd 时才需要
# EMERALD_LOCAL_DATA_ROOT=/path/to/data
# 本地凭据目录（加密 ZIP 密码引用；密码不得作为工具参数传入）
# EMERALD_CREDENTIALS_DIR=/path/to/credentials

# ============ 安全平面划分 ============
# 各平面的根目录白名单，多个路径用系统分隔符（: 或 ;）分隔
# EMERALD_DATA_PLANE_ROOTS=/path/to/data
# EMERALD_DOCUMENT_PLANE_ROOTS=/path/to/docs
# EMERALD_SPEC_PLANE_ROOTS=/path/to/spec
# EMERALD_OUTPUT_PLANE_ROOT=/path/to/output

# ============ 审计与限额 ============
# 审计日志根目录
# EMERALD_AUDIT_ROOT=/path/to/audit/logs
# 单会话单项目的 run/publish 次数上限，默认 50
# EMERALD_LISTING_MAX_EXECUTIONS=50
# 单会话代码执行次数上限
# EMERALD_LISTING_MAX_CODE_RUNS=50
# 审计标识哈希盐值（生产环境务必设置为随机值）
# EMERALD_HASH_SALT=change-me-in-production
# EMERALD_SIGNING_SALT=change-me-in-production

# ============ 超时配置（毫秒）============
# Listing 操作超时（重本地 I/O）
# EMERALD_LISTING_TIMEOUT_MS=120000
# 钩子超时
# EMERALD_HOOK_TIMEOUT_MS=120000

# ============ 企业认证（可选插件）============
# 在 configs/cordis.yml 中将 enterprise-auth 的 disabled 改为 false 后生效
OAUTH2_CLIENT_ID=your-client-id
OAUTH2_CLIENT_SECRET=your-client-secret
OAUTH2_AUTH_URL=https://auth.example.com/oauth/authorize
OAUTH2_TOKEN_URL=https://auth.example.com/oauth/token
OAUTH2_USERINFO_URL=https://auth.example.com/oauth/userinfo

# LDAP 认证（可选）
LDAP_URL=ldap://ldap.company.com
LDAP_BIND_DN=cn=admin,dc=company,dc=com
LDAP_PASSWORD=your-ldap-password
