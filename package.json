{
  "name": "@dsh-enterprise/platform",
  "version": "0.1.0",
  "private": true,
  "description": "企业 DeepSeek Harness 扩展平台：官方 Harness 基线之上的独立插件与 Profile 层",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test && vitest run --dir tests",
    "lint": "oxlint packages scripts tests",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "check:all": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:architecture && pnpm run check:secrets && pnpm run check:python && pnpm run check:upstream && pnpm run profile:verify",
    "upstream:status": "node scripts/upstream.mjs status",
    "upstream:sync": "node scripts/upstream.mjs sync",
    "upstream:verify": "node scripts/upstream.mjs verify",
    "profile:dump": "node scripts/profile.mjs dump",
    "profile:install": "node scripts/profile.mjs install",
    "profile:run": "node scripts/profile.mjs run",
    "clean": "node scripts/clean.mjs",
    "start": "node scripts/start.mjs",
    "profile:verify": "node scripts/profile.mjs verify",
    "check:python": "python packages/enterprise/listing/python/check_deps.py",
    "profile:smoke": "node scripts/profile-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "oxlint": "1.80.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
