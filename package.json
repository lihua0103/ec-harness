{
  "name": "@dsh-guard/root",
  "version": "0.1.0",
  "description": "DSH Guard - 基于 DeepSeek Harness 的企业级 AI Agent 框架",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/enterprise/*"
  ],
  "scripts": {
    "start": "dsh web --config configs/cordis.yml",
    "start:headless": "dsh headless --config configs/cordis.yml",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test:unit",
    "test:integration": "pnpm -r run test:integration",
    "test:e2e": "pnpm -r run test:e2e",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "pnpm -r exec rm -rf lib dist node_modules"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "^0.1.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.8",
    "tsx": "^4.22.4"
  }
}
